{
  "name": "dsh-notify",
  "version": "0.1.0",
  "description": "Unified notification plugin for DeepSeek Harness: browser notifications, sound, and Bark push over one event model.",
  "type": "module",
  "license": "MIT",
  "author": "姚壬亮 <yaorenliang@foxmail.com>",
  "homepage": "https://github.com/yaorenliang/dsh-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaorenliang/dsh-notify.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "notification",
    "bark"
  ],
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
